# systemd unit for Linux. Adjust User and paths, then:
#   sudo cp scripts/jellyfin-broadcast.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jellyfin-broadcast
[Unit]
Description=Barnes Television Broadcasting System (24/7 TV channels from Jellyfin)
After=network-online.target jellyfin.service
Wants=network-online.target

[Service]
Type=simple
User=jellyfin
WorkingDirectory=/opt/JellyfinBroadcast
ExecStartPre=/bin/sh -c '[ -x .venv/bin/python ] || (python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt)'
ExecStart=/opt/JellyfinBroadcast/.venv/bin/python broadcast.py --port 8420
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
